<!DOCTYPE html>
<html lang="en" meta="http://www.w3.org/1999/xhtml" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="BBC-style news site example built with Flask. Latest headlines, opinion, culture, sport and technology." />
    <meta name="keywords" content="BBC,news,articles,technology,sport,culture,world" />
    <title>
        {% block title %}
            BBC News - Home
        {% endblock title %}
    </title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="{{ url_for('static', filename='css/site.css') }}">
    {% block styles %}
    <style>
        /* Basic Reset & Body */
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            color: #1a1a1a;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* --- Top Navigation Bar --- */
        .bbc-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 15px;
            height: 50px;
            border-bottom: 1px solid #cccccc;
            background-color: #ffffff;
        }

        .top-bar-left {
            display: flex;
            align-items: center;
        }

        .top-bar-left .menu-icon,
        .top-bar-left .search-icon {
            font-size: 1.4em;
            padding: 0 10px;
            cursor: pointer;
            color: #333;
        }

        .top-bar-left .search-icon {
            margin-left: 5px;
        }

        .top-bar-center .bbc-logo img {
            height: 28px;
            display: block;
        }

        .top-bar-right {
            display: flex;
            align-items: center;
        }

        .top-bar-right .register-button {
            background-color: #222222;
            color: #ffffff;
            padding: 8px 15px;
            font-weight: bold;
            font-size: 0.9em;
            border-radius: 3px;
            margin-right: 15px;
        }

        .top-bar-right .register-button:hover {
            background-color: #444444;
        }

        .top-bar-right .signin-link {
            font-weight: bold;
            font-size: 0.9em;
            color: #333;
        }

        .top-bar-right .signin-link:hover {
            text-decoration: underline;
        }

        /* --- Main Category Navigation Bar --- */
        .bbc-main-categories {
            background-color: #ffffff;
            border-bottom: 1px solid #cccccc;
            height: 45px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .main-categories-nav {
            display: flex;
            height: 100%;
            max-width: 1280px;
            width: 100%;
            padding: 0 15px;
        }

        .main-categories-nav a {
            display: flex;
            align-items: center;
            padding: 0 12px;
            font-weight: bold;
            font-size: 0.9em;
            color: #333;
            height: 100%;
            border-bottom: 3px solid transparent;
            white-space: nowrap;
        }

        .main-categories-nav a:hover,
        .main-categories-nav a.active {
            border-bottom: 3px solid #1a1a1a;
            color: #1a1a1a;
        }

        .main-categories-nav a#cat-home.active {
            border-bottom: 3px solid #1a1a1a;
            color: #1a1a1a;
        }

        /* --- Main Content Area --- */
        .page-content {
            max-width: 1024px;
            margin: 20px auto;
            padding: 0 15px;
        }

        /* --- News Layout Grid (Based on Screenshot) --- */
        .news-layout-grid {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            gap: 25px;
        }

        /* --- Column Styling --- */
        .news-column-left,
        .news-column-center,
        .news-column-right {
            /* Basic column setup */
        }

        /* --- General Card Styling --- */
        .news-card {
            margin-bottom: 20px;
        }

        .news-card img {
            width: 100%;
            height: auto;
            display: block;
            margin-bottom: 8px;
        }

        .news-card h2,
        .news-card h3 {
            margin: 0 0 5px 0;
            font-size: 1.3em;
            font-weight: bold;
            line-height: 1.2;
            color: #1a1a1a;
        }

        .news-card h3 {
            font-size: 1.15em;
        }

        .news-card p {
            margin: 0 0 8px 0;
            font-size: 0.95em;
            line-height: 1.4;
            color: #4a4a4a;
        }

        .news-card .metadata {
            font-size: 0.8em;
            color: #5a5a5a;
        }

        .news-card .metadata time {
            margin-right: 5px;
        }

        .news-card .metadata .category {
            border-left: 1px solid #cccccc;
            padding-left: 8px;
            margin-left: 5px;
        }

        /* --- Specific Card Styles --- */
        .news-column-center .news-card h2 {
            font-size: 1.8em;
            margin-bottom: 10px;
        }

        .news-column-right .news-card {
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 15px;
        }

        .news-column-right .news-card:last-child {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .news-column-right .news-card h3 {
            font-size: 1.05em;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .news-column-right .news-card p {
            font-size: 0.9em;
            margin-bottom: 8px;
        }

        /* --- Utility --- */
        .icon {
            display: inline-block;
        }

        .top-bar-center .bbc-logo img {
            height: 50px;
            width: auto;
            display: block;
            align: center;
        }

        #bbc-logo img {
            height: 120px;
            width: auto;
            display: block;
        }

        header {
            background-color: white;
            color: black;
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* Style the buttons and links */
        .register-button {
            background-color: black;
            color: white;
        }

        /* Styles for the new film review section */
        .film-review-section {
            margin-top: 20px; /* Add some space above the section */
            border-top: 1px solid #ccc; /* Add a separator line */
            padding-top: 20px;
        }

        .film-review-content {
            display: flex;
            align-items: flex-start; /* Align items to the top */
            gap: 20px; /* Space between image and text */
        }

        .film-review-image {
            flex: 1; /* Take up available space */
        }

        .film-review-image img {
            width: 100%; /* Image takes full width of its container */
            height: auto;
            display: block;
        }

        .film-review-text {
            flex: 1; /* Take up available space */
        }

        .film-review-category {
            font-size: 0.8em;
            color: #5a5a5a;
            margin-bottom: 5px;
        }

        .film-review-title {
            font-size: 1.5em;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .film-review-stars {
            color: #ff9900; /* Example star color */
            margin-bottom: 10px;
        }

        .film-review-description {
            font-size: 0.95em;
            line-height: 1.4;
            color: #4a4a4a;
            margin-bottom: 15px;
        }

        .film-review-link {
            display: inline-block;
            padding: 8px 15px;
            color: #333;
            text-decoration: none;
            font-size: 0.9em;
        }

        .film-review-link:hover {
            background-color: #f0f0f0;
        }

        /* Styles for the new news sections */
        .news-sections {
            margin-top: 20px;
            border-top: 1px solid #ccc;
            padding-top: 20px;
        }

        .news-sections-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr); /* Four columns */
            gap: 20px;
        }

        .news-section {
            /* Basic styling for each section */
        }

        .news-section > a {
            font-size: 0.8em;
            font-weight: bold;
            color: #333;
            display: block;
            margin-bottom: 10px;
        }

        .news-item {
            margin-bottom: 15px;
        }

        .news-item img {
            width: 100%;
            height: auto;
            display: block;
            margin-bottom: 5px;
        }

        .news-item h3 {
            font-size: 1em;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .news-item p {
            font-size: 0.85em;
            color: #4a4a4a;
            margin-bottom: 5px;
        }

        .news-item .metadata {
            font-size: 0.7em;
            color: #5a5a5a;
        }

        /* Footer Styles */
        .bbc-footer {
            margin-top: 20px;
            border-top: 1px solid #ccc;
            padding-top: 20px;
            text-align: center;
            font-size: 0.8em;
            color: #5a5a5a;
        }

        .footer-links {
            margin-bottom: 10px;
        }

        .footer-links a {
            margin: 0 5px;
        }

        .language-select {
            margin-bottom: 10px;
        }

        .social-links {
            margin-bottom: 10px;
        }

        .social-links a {
            margin: 0 5px;
        }

        .copyright {
            font-size: 0.7em;
        }
        /* Utility classes to replace inline styles */
        .footer-logo {
            height: 120px;
            margin-bottom: 10px;
        }

        .header-logo {
            height: 120px;
            width: auto;
            display: block;
        }

        .icon-small {
            height: 15px;
            width: 15px;
            vertical-align: middle;
        }
        /* Skip-link helper moved here from header partial */
        .visually-hidden-focusable { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
        .visually-hidden-focusable:focus { position: static; width: auto; height: auto; margin: 8px; padding: 6px 8px; background: #fff; border: 1px solid #ccc; z-index: 9999; }
    </style>
    {% endblock styles %}
</head>
<body>
    {# include partial header for Phase 3 #}
    {% include "_header.html.j2" %}
    {# import macros for site-wide use #}
    {% import "_macros.html.j2" as macros %}

    <main class="page-content">
    {# include partials for cards and widgets (phase 3) #}
    {% include "_news_card.html.j2" %}
    {% include "_weather_widget.html.j2" %}

        {% block content %}
            {# Page-specific content will be inserted here #}
        {% endblock content %}
    </main>

    {# include partial footer for Phase 3 #}
    {% include "_footer.html.j2" %}

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.main-categories-nav a');
            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === currentPath) {
                    link.classList.add('active');
                }
            });
        });
    </script>
</body>
</html>