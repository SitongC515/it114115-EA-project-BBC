{% extends "base.html.j2" %}

{# Official dynamic homepage: latest article in center, next two in left column, rest on the right #}
{% block styles %}{{ super() }}{% endblock styles %}

{% block title %}
{% if title %}{{ title }} - BBC News{% else %}BBC News - Home{% endif %}
{% endblock title %}

{% block content %}
<header>
    <div class="bbc-top-bar">
        <div class="top-bar-left">
            <span class="menu-icon"><i class="fas fa-bars"></i></span>
            <span class="search-icon"><i class="fas fa-search"></i></span>
        </div>
        <div class="top-bar-center">
            <a href="{{ url_for('index') }}" id="bbc-logo" title="BBC Home">
                <img src="https://www.pngall.com/wp-content/uploads/15/BBC-Logo-PNG-Image.png" alt="BBC Logo" class="header-logo" width="120" height="50" />
            </a>
        </div>
        <div class="top-bar-right">
            {% if current_user.is_authenticated %}
                <a href="{{ url_for('logout') }}" class="logout-link">logout</a>
            {% else %}
                <a href="{{ url_for('login') }}" class="signin-link">Sign in</a>
            {% endif %}
        </div>
    </div>
    <nav class="bbc-main-categories">
        <div class="main-categories-nav">
            <a href="{{ url_for('index') }}" id="cat-home" class="active">Home</a>
            <a href="{{ url_for('Article') }}" id="cat-Article">Article</a>
            <a href="{{ url_for('weather') }}" id="cat-weather">Weather</a>
            <a href="{{ url_for('comment') }}" id="cat-Comment">Comment</a>
        </div>
    </nav>
</header>

<main class="page-content">
    <div class="news-layout-grid">

        <!-- Left Column: next two most-recent -->
        <section class="news-column-left">
            {% if articles and articles|length > 1 %}
                {% set left = articles[1:3] %}
                {% for a in left %}
                    {{ macros.news_card(a) }}
                {% endfor %}
            {% endif %}
        </section>

        <!-- Center Column: latest (most recent) article -->
        <section class="news-column-center">
            {% if articles and articles|length > 0 %}
                {{ macros.news_card(articles[0]) }}
            {% else %}
                <p>No articles available.</p>
            {% endif %}
        </section>

        <!-- Right Column: remaining articles -->
        <section class="news-column-right">
            {% if articles and articles|length > 3 %}
                {% for a in articles[3:] %}
                    {{ macros.news_card(a) }}
                {% endfor %}
            {% elif articles and articles|length == 3 %}
                {# when exactly 3 articles, show the third as the first right-column item #}
                {{ macros.news_card(articles[2]) }}
            {% endif %}
        </section>

    </div> <!-- End news-layout-grid -->

    <!-- Film Review Section (kept as a static promotional block) -->
    <section class="film-review-section">
        <div class="film-review-content">
            <div class="film-review-image">
                <img src="https://ichef.bbci.co.uk/images/ic/1920x1080/p0l3mr3n.jpg.webp" alt="Warfare Film Still" width="1920" height="1080">
            </div>
            <div class="film-review-text">
                <div class="news-section"><a href="#">CULTURE &gt; </a></div>
                <a href="#"><h3 class="film-review-title">Warfare: 'A bold marvel of a film'</h3></a>
                <div class="film-review-stars">★★★★★</div>
                <p class="film-review-description">The Ex Machina director's new epic starring Will Poulter and Cosmo Jarvis was co-directed with a former US Navy Seal, and according to BBC Culture it "does what film does best".</p>
                        {% if film_article_id %}
                            <a href="{{ url_for('article_detail', article_id=film_article_id) }}" class="film-review-link">See more</a>
                        {% else %}
                            <a href="#" class="film-review-link">See more</a>
                        {% endif %}
            </div>
        </div>
    </section>

    <!-- News Sections (static placeholders) -->
    <section class="news-sections">
        <div class="news-sections-grid">
            <div class="news-section"><a href="#">US & CANADA NEWS &gt;</a></div>
            <div class="news-section"><a href="#">MORE WORLD NEWS &gt;</a></div>
            <div class="news-section"><a href="#">SPORT &gt;</a></div>
            <div class="news-section"><a href="#">BUSINESS &gt;</a></div>
        </div>
    </section>

</main>

<!-- BBC Footer -->
<footer class="bbc-footer">
    <a href="{{ url_for('index') }}"><img src="https://www.pngall.com/wp-content/uploads/15/BBC-Logo-PNG-Image.png" alt="BBC Logo" class="footer-logo" width="200" height="120"></a>
    <div class="footer-links">
        <a href="{{ url_for('index') }}">Home</a>
        <a href="{{ url_for('Article') }}">Article</a>
        <a href="{{ url_for('weather') }}">Weather</a>
        <a href="{{ url_for('comment') }}">Comment</a>
    </div>
    <div class="language-select">
        <select>
            <option>BBC in other languages</option>
            <option>English</option>
            <option>Chinese</option>
            <option>Spanish</option>
        </select>
    </div>
    <div class="footer-links">
        <a href="#">Terms of Use</a>
        <a href="#">About the BBC</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Cookies</a>
        <a href="#">Accessibility Help</a>
        <a href="#">Contact the BBC</a>
    </div>
    <div class="copyright">
        Copyright 2025 BBC. All rights reserved. The BBC is not responsible for the content of external sites. <a href="#">Read about our approach to external linking.</a>
    </div>
</footer>

{% endblock content %}