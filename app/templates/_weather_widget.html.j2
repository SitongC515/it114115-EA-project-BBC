<!-- Partial: weather widget (accessible) -->
<aside class="weather-widget" role="complementary" aria-label="Weather widget">
    <h4>Weather</h4>
    <ul aria-live="polite">
    {% for w in (weather_data or [])[:3] %}
        <li><strong>{{ w.city }}</strong>: {{ w.today_temperature_high }}° / {{ w.today_temperature_low }}° — {{ w.today_description or '' }}</li>
    {% else %}
        <li>No weather data</li>
    {% endfor %}
    </ul>
</aside>
